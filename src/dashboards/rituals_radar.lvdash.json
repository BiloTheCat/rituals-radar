{
  "datasets": [
    {
      "name": "ds_stock_kpis",
      "displayName": "Stock KPIs",
      "queryLines": [
        "SELECT s.products_tracked, s.out_of_stock_now, d.availability_pct_7d\n",
        "FROM (\n",
        "  SELECT COUNT(*) AS products_tracked,\n",
        "         SUM(CASE WHEN is_available THEN 0 ELSE 1 END) AS out_of_stock_now\n",
        "  FROM workspace.rituals_radar.gold_stock_current\n",
        ") s\n",
        "CROSS JOIN (\n",
        "  SELECT ROUND(AVG(availability_rate) * 100, 1) AS availability_pct_7d\n",
        "  FROM workspace.rituals_radar.gold_stock_daily\n",
        "  WHERE snapshot_date >= date_sub(current_date(), 7)\n",
        ") d"
      ]
    },
    {
      "name": "ds_stock_current",
      "displayName": "Current stock status",
      "queryLines": [
        "SELECT\n",
        "  CASE WHEN is_available THEN '✅ In stock'\n",
        "       WHEN availability = 'Delisted' THEN '⛔ Delisted'\n",
        "       ELSE concat('❌ ', availability) END AS status,\n",
        "  product_name AS product,\n",
        "  initcap(replace(collection, '_', ' ')) AS collection,\n",
        "  status_since,\n",
        "  hours_in_status,\n",
        "  price,\n",
        "  list_price,\n",
        "  last_checked_at\n",
        "FROM workspace.rituals_radar.gold_stock_current\n",
        "ORDER BY is_available ASC, hours_in_status DESC"
      ]
    },
    {
      "name": "ds_availability_trend",
      "displayName": "Availability per collection (lowest 6)",
      "queryLines": [
        "WITH lowest AS (\n",
        "  SELECT collection\n",
        "  FROM workspace.rituals_radar.gold_collection_availability_daily\n",
        "  WHERE snapshot_date >= date_sub(current_date(), 30)\n",
        "  GROUP BY collection\n",
        "  ORDER BY AVG(availability_rate) ASC\n",
        "  LIMIT 6\n",
        ")\n",
        "SELECT d.snapshot_date, initcap(replace(d.collection, '_', ' ')) AS collection,\n",
        "       ROUND(d.availability_rate * 100, 1) AS availability_pct\n",
        "FROM workspace.rituals_radar.gold_collection_availability_daily d\n",
        "JOIN lowest l ON l.collection = d.collection\n",
        "WHERE d.snapshot_date >= date_sub(current_date(), 30)"
      ]
    },
    {
      "name": "ds_stockout_hours",
      "displayName": "Hours sold out per product (30 days)",
      "queryLines": [
        "SELECT product_name AS product,\n",
        "       COUNT(*) AS stockouts,\n",
        "       ROUND(SUM(duration_hours), 1) AS hours_sold_out\n",
        "FROM workspace.rituals_radar.gold_stockout_events\n",
        "WHERE stockout_start >= date_sub(current_date(), 30)\n",
        "GROUP BY product_name\n",
        "ORDER BY hours_sold_out DESC\n",
        "LIMIT 10"
      ]
    },
    {
      "name": "ds_open_stockouts",
      "displayName": "Sold out right now",
      "queryLines": [
        "SELECT product_name AS product,\n",
        "       initcap(replace(collection, '_', ' ')) AS collection,\n",
        "       stockout_start AS sold_out_since,\n",
        "       duration_hours AS hours_sold_out\n",
        "FROM workspace.rituals_radar.gold_stockout_events\n",
        "WHERE is_ongoing\n",
        "ORDER BY duration_hours DESC"
      ]
    },
    {
      "name": "ds_scorecard",
      "displayName": "Collection scorecard (30 days)",
      "queryLines": [
        "SELECT initcap(replace(collection, '_', ' ')) AS collection,\n",
        "       products_tracked,\n",
        "       ROUND(availability_rate_30d * 100, 1) AS availability_pct_30d,\n",
        "       stockouts_30d,\n",
        "       avg_stockout_hours_30d,\n",
        "       hours_sold_out_30d\n",
        "FROM workspace.rituals_radar.gold_collection_scorecard\n",
        "ORDER BY availability_rate_30d ASC"
      ]
    },
    {
      "name": "ds_collection_availability",
      "displayName": "Availability per collection (30 days)",
      "queryLines": [
        "SELECT initcap(replace(collection, '_', ' ')) AS collection,\n",
        "       ROUND(availability_rate_30d * 100, 1) AS availability_pct_30d\n",
        "FROM workspace.rituals_radar.gold_collection_scorecard"
      ]
    },
    {
      "name": "ds_discounts",
      "displayName": "Products on discount right now",
      "queryLines": [
        "SELECT product_name AS product,\n",
        "       initcap(replace(collection, '_', ' ')) AS collection,\n",
        "       price,\n",
        "       list_price,\n",
        "       ROUND(discount_pct * 100, 0) AS discount_pct\n",
        "FROM workspace.rituals_radar.gold_product_scorecard\n",
        "WHERE discount_pct > 0\n",
        "ORDER BY discount_pct DESC"
      ]
    },
    {
      "name": "ds_new_products",
      "displayName": "New in the catalogue",
      "queryLines": [
        "SELECT slug AS product,\n",
        "       initcap(replace(collection, '_', ' ')) AS collection,\n",
        "       first_seen_at,\n",
        "       is_listed,\n",
        "       url\n",
        "FROM workspace.rituals_radar.gold_catalog_products\n",
        "WHERE is_new_launch\n",
        "ORDER BY first_seen_at DESC"
      ]
    },
    {
      "name": "ds_nearest_stores",
      "displayName": "Nearest stores per postcode",
      "queryLines": [
        "SELECT pc4,\n",
        "       nearest_rank,\n",
        "       store_name AS store,\n",
        "       concat(street_address, ', ', postal_code, ' ', city) AS address,\n",
        "       distance_km,\n",
        "       opening_hours,\n",
        "       url AS store_page\n",
        "FROM workspace.rituals_radar.gold_store_distance\n",
        "ORDER BY pc4, nearest_rank"
      ]
    },
    {
      "name": "ds_product_check",
      "displayName": "Uukumwe product: in-store check",
      "queryLines": [
        "SELECT product_name AS product,\n",
        "       CASE WHEN is_available THEN '✅ Online in stock' ELSE concat('❌ Online: ', availability) END AS online_status,\n",
        "       price,\n",
        "       url AS check_in_store\n",
        "FROM workspace.rituals_radar.gold_stock_current\n",
        "WHERE collection = 'uukumwe'\n",
        "ORDER BY product_name"
      ]
    }
  ],
